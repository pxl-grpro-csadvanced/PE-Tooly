<Window x:Class="Tooly.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tooly.WPF"
        mc:Ignorable="d"
        Title="T o o l y" Height="450" Width="600">
    <Grid ColumnDefinitions="2*,*" Margin="10">
        <ListBox x:Name="productsListBox" Margin="10" SelectionChanged="productsListBox_SelectionChanged"/>
        <DockPanel Grid.Column="1" Margin="10" >
            <StackPanel DockPanel.Dock="Bottom" x:Name="actionPanel">
                <Button x:Name="addProductButton" 
                  Padding="5"         
                  Content="Product toevoegen" Click="addProductButton_Click" Margin="0,10,0,0"/>
            </StackPanel>
  
            <StackPanel x:Name="detailsPanel">
                <Label Content="Naam:"/>
                <TextBox x:Name="nameTextBox" Margin="0,0,0,10" IsReadOnly="True"/>
                <Label Content="Categorie:"/>
                <TextBox x:Name="categoryTextBox" Margin="0,0,0,10" IsReadOnly="True"/>
            </StackPanel>
        </DockPanel>

    </Grid>
</Window>
